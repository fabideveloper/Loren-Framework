    "roblox",
    "luau",
    "framework",
    "rojo",
    "argon",
    "networking",
    "cli"
  ],
  "homepage": "https://fabideveloper.github.io/Loren-Framework/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabideveloper/Loren-Framework.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/fabideveloper/Loren-Framework/issues"
  },
  "license": "MIT",
  "author": "Fabi",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "loren": "./index.js"
  },
  "files": [
    "index.js",
    "lib/",
    "project/default.project.json",
    "project/selene.toml",
    "project/loren/",
    "project/src/",
    "project/loren_premade/services/PointsService.luau",
    "project/loren_premade/controllers/PointsController.luau",
    "project/loren_premade/shared/ExampleShared.luau",
    "project/loren_packages/Promise/default.project.json",
    "project/loren_packages/Promise/LICENSE",
    "project/loren_packages/Promise/lib/init.lua",
    "!project/loren_packages/Promise/README.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test"
  },
  "dependencies": {
    "commander": "^11.0.0",
    "degit": "^2.8.4",
    "fs-extra": "^11.1.0",
    "update-notifier": "^7.3.1"
  }
}
