{
    "name": "project",
    "globIgnorePaths": [
        "loren_packages/**/*.spec.lua",
        "loren_packages/**/*.spec.luau"
    ],
    "tree": {
        "$className": "DataModel",
        "ReplicatedStorage": {
            "Shared": {
                "$path": "src/shared"
            },
            "LorenPackages": {
                "$path": "loren_packages"
            },
            "LorenRuntime": {
                "$path": "loren/shared"
            }
        },
        "ServerScriptService": {
            "Server": {
                "$path": "src/server"
            },
            "LorenServer": {
                "$path": "loren/server"
            }
        },
        "StarterPlayer": {
            "StarterPlayerScripts": {
                "Client": {
                    "$path": "src/client"
                }
            }
        }
    }
}
