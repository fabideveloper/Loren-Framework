	BITFIELD_1_0 = 0
	if Value.jump then BITFIELD_1_0 += 0x01 end
	if Value.sprint then BITFIELD_1_0 += 0x02 end
	buffer.writeu8(SendBuffer, BLOCK_START + 9, BITFIELD_1_0)
end

function SerdesFunctions.WriteEVENT_CInputUnreliable(Value: { seq: number, moveX: number, moveZ: number, yaw: number, jump: boolean, sprint: boolean }): ()
	-- Allocate BLOCK: 10 bytes
