	BITFIELD_1_0 = buffer.readu8(RecieveBuffer, BLOCK_START + 27)
	Value.alive = bit32.btest(BITFIELD_1_0, 0x01)
	Value.moving = bit32.btest(BITFIELD_1_0, 0x02)
	Value.crouched = bit32.btest(BITFIELD_1_0, 0x04)
	return Value
end

function SerdesFunctions.ReadEVENT_SEntities(): ({ { id: number, position: Vector3, orientation: Vector3, health: number, alive: boolean, moving: boolean, crouched: boolean } })
	-- Read BLOCK: 1 bytes
	local BLOCK_START = Read(1)
	local RecieveBuffer = RecieveBuffer
	-- START ARRAY
	local Length = buffer.readu8(RecieveBuffer, BLOCK_START + 0)
	if not (Length <= 100) then error(`Expected "Length" to be smaller than or equal to 100, got {Length} instead.`) end
	if Length * 28 > buffer.len(RecieveBuffer) - RecieveCursor then error(`Expected "Value" to fit in the {buffer.len(RecieveBuffer) - RecieveCursor} bytes left in the packet, got a length of {Length} instead.`) end
	local Value = table.create(Length)
		-- Read BLOCK: 28 bytes
	local ARRAY_START_1 = Read(28 * Length)
	local BITFIELD_2_0
	for Slot_1 = 1, Length do
		local Item_1 = {id = false, position = false, orientation = false, health = false, alive = false, moving = false, crouched = false} :: any
		do
			-- Read 2
			local OPERATION_OFFSET_0 = ARRAY_START_1
			ARRAY_START_1 += 2
			Item_1.id = buffer.readu16(RecieveBuffer, OPERATION_OFFSET_0)
		end
		do
			-- Read 4
			local OPERATION_OFFSET_1 = ARRAY_START_1
			ARRAY_START_1 += 4
			local X = buffer.readf32(RecieveBuffer, OPERATION_OFFSET_1)
			-- Read 4
			local OPERATION_OFFSET_2 = ARRAY_START_1
			ARRAY_START_1 += 4
			local Y = buffer.readf32(RecieveBuffer, OPERATION_OFFSET_2)
			-- Read 4
			local OPERATION_OFFSET_3 = ARRAY_START_1
			ARRAY_START_1 += 4
			local Z = buffer.readf32(RecieveBuffer, OPERATION_OFFSET_3)
			Item_1.position = Vector3.new(X, Y, Z)
		end
		do
			-- Read 4
			local OPERATION_OFFSET_4 = ARRAY_START_1
			ARRAY_START_1 += 4
			local X = buffer.readf32(RecieveBuffer, OPERATION_OFFSET_4)
			-- Read 4
			local OPERATION_OFFSET_5 = ARRAY_START_1
			ARRAY_START_1 += 4
			local Y = buffer.readf32(RecieveBuffer, OPERATION_OFFSET_5)
			-- Read 4
			local OPERATION_OFFSET_6 = ARRAY_START_1
			ARRAY_START_1 += 4
			local Z = buffer.readf32(RecieveBuffer, OPERATION_OFFSET_6)
			Item_1.orientation = Vector3.new(X, Y, Z)
		end
		do
			-- Read 1
			local OPERATION_OFFSET_7 = ARRAY_START_1
			ARRAY_START_1 += 1
			Item_1.health = buffer.readu8(RecieveBuffer, OPERATION_OFFSET_7)
		end
		do
			-- Read 1
			local OPERATION_OFFSET_8 = ARRAY_START_1
			ARRAY_START_1 += 1
			BITFIELD_2_0 = buffer.readu8(RecieveBuffer, OPERATION_OFFSET_8)
			Item_1.alive = bit32.btest(BITFIELD_2_0, 0x01)
		end
		Item_1.moving = bit32.btest(BITFIELD_2_0, 0x02)
		Item_1.crouched = bit32.btest(BITFIELD_2_0, 0x04)
		Value[Slot_1] = Item_1
	end
	-- END ARRAY
	return Value
end

function SerdesFunctions.ReadEVENT_SEntityUnreliable(): ({ id: number, position: Vector3, orientation: Vector3, health: number, alive: boolean, moving: boolean, crouched: boolean })
	-- Read BLOCK: 28 bytes
	local BLOCK_START = Read(28)
	local BITFIELD_1_0
	local RecieveBuffer = RecieveBuffer
	local Value = {id = false, position = false, orientation = false, health = false, alive = false, moving = false, crouched = false} :: any
	Value.id = buffer.readu16(RecieveBuffer, BLOCK_START + 0)
	do
		local X = buffer.readf32(RecieveBuffer, BLOCK_START + 2)
		local Y = buffer.readf32(RecieveBuffer, BLOCK_START + 6)
		local Z = buffer.readf32(RecieveBuffer, BLOCK_START + 10)
		Value.position = Vector3.new(X, Y, Z)
	end
	do
		local X = buffer.readf32(RecieveBuffer, BLOCK_START + 14)
		local Y = buffer.readf32(RecieveBuffer, BLOCK_START + 18)
		local Z = buffer.readf32(RecieveBuffer, BLOCK_START + 22)
		Value.orientation = Vector3.new(X, Y, Z)
	end
	Value.health = buffer.readu8(RecieveBuffer, BLOCK_START + 26)
	BITFIELD_1_0 = buffer.readu8(RecieveBuffer, BLOCK_START + 27)
	Value.alive = bit32.btest(BITFIELD_1_0, 0x01)
	Value.moving = bit32.btest(BITFIELD_1_0, 0x02)
	Value.crouched = bit32.btest(BITFIELD_1_0, 0x04)
	return Value
end

function SerdesFunctions.ReadEVENT_SPose(): (CFrame)
	-- Read BLOCK: 19 bytes
	local BLOCK_START = Read(19)
	local RecieveBuffer = RecieveBuffer
	local X = buffer.readf32(RecieveBuffer, BLOCK_START + 0)
	local Y = buffer.readf32(RecieveBuffer, BLOCK_START + 4)
	local Z = buffer.readf32(RecieveBuffer, BLOCK_START + 8)
	local QIndex = buffer.readu8(RecieveBuffer, BLOCK_START + 12)
	local QA = buffer.readi16(RecieveBuffer, BLOCK_START + 13)
	local QB = buffer.readi16(RecieveBuffer, BLOCK_START + 15)
	local QC = buffer.readi16(RecieveBuffer, BLOCK_START + 17)
	local Value = UnpackRotation(X, Y, Z, QIndex, QA, QB, QC)
	return Value
end

function SerdesFunctions.WriteEVENT_CBool(Value: boolean): ()
	-- Allocate BLOCK: 2 bytes
	local BLOCK_START = Allocate(2)
	local BITFIELD_1_0
	buffer.writeu8(SendBuffer, BLOCK_START + 0, 5)
	BITFIELD_1_0 = 0
	if Value then BITFIELD_1_0 += 0x01 end
	buffer.writeu8(SendBuffer, BLOCK_START + 1, BITFIELD_1_0)
end

function SerdesFunctions.WriteEVENT_CBoolArray(Value: { boolean }): ()
	-- Allocate BLOCK: 1 bytes
	local BLOCK_START = Allocate(1)
	buffer.writeu8(SendBuffer, BLOCK_START + 0, 6)
	-- START ARRAY
	if not (#Value <= 1000) then error(`Expected "#Value" to be smaller than or equal to 1000, got {#Value} instead.`) end
	WriteVarLength(#Value)
	do
		local PACKED_LENGTH = #Value
		local PACKED_OFFSET = Allocate((PACKED_LENGTH + 7) // 8)
		local PACKED_WHOLE = PACKED_LENGTH // 8
		for PACKED_BYTE = 0, PACKED_WHOLE - 1 do
			local PACKED_BASE = PACKED_BYTE * 8
			local PACKED_1, PACKED_2, PACKED_3, PACKED_4 = Value[PACKED_BASE + 1], Value[PACKED_BASE + 2], Value[PACKED_BASE + 3], Value[PACKED_BASE + 4]
			local PACKED_5, PACKED_6, PACKED_7, PACKED_8 = Value[PACKED_BASE + 5], Value[PACKED_BASE + 6], Value[PACKED_BASE + 7], Value[PACKED_BASE + 8]
			local PACKED_BITS = 0
			if PACKED_1 then PACKED_BITS += 1 end
			if PACKED_2 then PACKED_BITS += 2 end
			if PACKED_3 then PACKED_BITS += 4 end
			if PACKED_4 then PACKED_BITS += 8 end
			if PACKED_5 then PACKED_BITS += 16 end
			if PACKED_6 then PACKED_BITS += 32 end
			if PACKED_7 then PACKED_BITS += 64 end
			if PACKED_8 then PACKED_BITS += 128 end
			buffer.writeu8(SendBuffer, PACKED_OFFSET + PACKED_BYTE, PACKED_BITS)
		end
		if PACKED_LENGTH % 8 ~= 0 then
			local PACKED_BASE = PACKED_WHOLE * 8
			local PACKED_BITS = 0
			for PACKED_BIT = 0, PACKED_LENGTH % 8 - 1 do
				local PACKED_ITEM = Value[PACKED_BASE + PACKED_BIT + 1]
				if PACKED_ITEM then PACKED_BITS += bit32.lshift(1, PACKED_BIT) end
			end
			buffer.writeu8(SendBuffer, PACKED_OFFSET + PACKED_WHOLE, PACKED_BITS)
		end
	end
	-- END ARRAY
end

function SerdesFunctions.WriteEVENT_CEntity(Value: { id: number, position: Vector3, orientation: Vector3, health: number, alive: boolean, moving: boolean, crouched: boolean }): ()
	-- Allocate BLOCK: 29 bytes
	local BLOCK_START = Allocate(29)
	local BITFIELD_1_0
	buffer.writeu8(SendBuffer, BLOCK_START + 0, 7)
	buffer.writeu16(SendBuffer, BLOCK_START + 1, Value.id)
	do
		local Vector = Value.position
		buffer.writef32(SendBuffer, BLOCK_START + 3, Vector.X)
		buffer.writef32(SendBuffer, BLOCK_START + 7, Vector.Y)
		buffer.writef32(SendBuffer, BLOCK_START + 11, Vector.Z)
	end
	do
		local Vector = Value.orientation
		buffer.writef32(SendBuffer, BLOCK_START + 15, Vector.X)
		buffer.writef32(SendBuffer, BLOCK_START + 19, Vector.Y)
		buffer.writef32(SendBuffer, BLOCK_START + 23, Vector.Z)
	end
	buffer.writeu8(SendBuffer, BLOCK_START + 27, Value.health)
	BITFIELD_1_0 = 0
	if Value.alive then BITFIELD_1_0 += 0x01 end
	if Value.moving then BITFIELD_1_0 += 0x02 end
	if Value.crouched then BITFIELD_1_0 += 0x04 end
	buffer.writeu8(SendBuffer, BLOCK_START + 28, BITFIELD_1_0)
end

function SerdesFunctions.WriteEVENT_CInput(Value: { seq: number, moveX: number, moveZ: number, yaw: number, jump: boolean, sprint: boolean }): ()
	-- Allocate BLOCK: 10 bytes
	local BLOCK_START = Allocate(10)
	local BITFIELD_1_0
	buffer.writeu8(SendBuffer, BLOCK_START + 0, 8)
	buffer.writeu16(SendBuffer, BLOCK_START + 1, Value.seq)
	buffer.writei8(SendBuffer, BLOCK_START + 3, Value.moveX)
	buffer.writei8(SendBuffer, BLOCK_START + 4, Value.moveZ)
