		buffer.writef32(SendBuffer, BLOCK_START + 23, Vector.Z)
	end
	buffer.writeu8(SendBuffer, BLOCK_START + 27, Value.health)
	BITFIELD_1_0 = 0
	if Value.alive then BITFIELD_1_0 += 0x01 end
	if Value.moving then BITFIELD_1_0 += 0x02 end
	if Value.crouched then BITFIELD_1_0 += 0x04 end
	buffer.writeu8(SendBuffer, BLOCK_START + 28, BITFIELD_1_0)
end

function SerdesFunctions.WriteEVENT_SEntities(Value: { { id: number, position: Vector3, orientation: Vector3, health: number, alive: boolean, moving: boolean, crouched: boolean } }): ()
	-- Allocate BLOCK: 2 bytes
	local BLOCK_START = Allocate(2)
	buffer.writeu8(SendBuffer, BLOCK_START + 0, 3)
	-- START ARRAY
	if not (#Value <= 100) then error(`Expected "#Value" to be smaller than or equal to 100, got {#Value} instead.`) end
	buffer.writeu8(SendBuffer, BLOCK_START + 1, #Value)
		-- Allocate BLOCK: 28 bytes
	local ARRAY_START_1 = Allocate(28 * #Value)
	local BITFIELD_2_0_OFFSET
	local BITFIELD_2_0
	for Index = 1, #Value do
		local Item_1 = Value[Index]
		do
			-- Allocate 2
			local OPERATION_OFFSET_0 = ARRAY_START_1
			ARRAY_START_1 += 2
			buffer.writeu16(SendBuffer, OPERATION_OFFSET_0, Item_1.id)
		end
		do
			local Vector = Item_1.position
			-- Allocate 4
			local OPERATION_OFFSET_1 = ARRAY_START_1
			ARRAY_START_1 += 4
			buffer.writef32(SendBuffer, OPERATION_OFFSET_1, Vector.X)
			-- Allocate 4
			local OPERATION_OFFSET_2 = ARRAY_START_1
			ARRAY_START_1 += 4
			buffer.writef32(SendBuffer, OPERATION_OFFSET_2, Vector.Y)
			-- Allocate 4
			local OPERATION_OFFSET_3 = ARRAY_START_1
			ARRAY_START_1 += 4
			buffer.writef32(SendBuffer, OPERATION_OFFSET_3, Vector.Z)
		end
		do
			local Vector = Item_1.orientation
			-- Allocate 4
			local OPERATION_OFFSET_4 = ARRAY_START_1
			ARRAY_START_1 += 4
			buffer.writef32(SendBuffer, OPERATION_OFFSET_4, Vector.X)
			-- Allocate 4
			local OPERATION_OFFSET_5 = ARRAY_START_1
			ARRAY_START_1 += 4
			buffer.writef32(SendBuffer, OPERATION_OFFSET_5, Vector.Y)
			-- Allocate 4
			local OPERATION_OFFSET_6 = ARRAY_START_1
			ARRAY_START_1 += 4
			buffer.writef32(SendBuffer, OPERATION_OFFSET_6, Vector.Z)
		end
		do
			-- Allocate 1
			local OPERATION_OFFSET_7 = ARRAY_START_1
			ARRAY_START_1 += 1
			buffer.writeu8(SendBuffer, OPERATION_OFFSET_7, Item_1.health)
		end
		do
			-- Allocate 1
			local OPERATION_OFFSET_8 = ARRAY_START_1
			ARRAY_START_1 += 1
			BITFIELD_2_0 = 0
			BITFIELD_2_0_OFFSET = OPERATION_OFFSET_8
			if Item_1.alive then BITFIELD_2_0 += 0x01 end
		end
		if Item_1.moving then BITFIELD_2_0 += 0x02 end
		if Item_1.crouched then BITFIELD_2_0 += 0x04 end
		buffer.writeu8(SendBuffer, BITFIELD_2_0_OFFSET, BITFIELD_2_0)
	end
	-- END ARRAY
end

function SerdesFunctions.WriteEVENT_SEntityUnreliable(Value: { id: number, position: Vector3, orientation: Vector3, health: number, alive: boolean, moving: boolean, crouched: boolean }): ()
	-- Allocate BLOCK: 29 bytes
	local BLOCK_START = Allocate(29)
	local BITFIELD_1_0
	buffer.writeu8(SendBuffer, BLOCK_START + 0, 0)
	buffer.writeu16(SendBuffer, BLOCK_START + 1, Value.id)
	do
		local Vector = Value.position
		buffer.writef32(SendBuffer, BLOCK_START + 3, Vector.X)
		buffer.writef32(SendBuffer, BLOCK_START + 7, Vector.Y)
		buffer.writef32(SendBuffer, BLOCK_START + 11, Vector.Z)
	end
	do
		local Vector = Value.orientation
		buffer.writef32(SendBuffer, BLOCK_START + 15, Vector.X)
		buffer.writef32(SendBuffer, BLOCK_START + 19, Vector.Y)
		buffer.writef32(SendBuffer, BLOCK_START + 23, Vector.Z)
	end
	buffer.writeu8(SendBuffer, BLOCK_START + 27, Value.health)
	BITFIELD_1_0 = 0
	if Value.alive then BITFIELD_1_0 += 0x01 end
	if Value.moving then BITFIELD_1_0 += 0x02 end
	if Value.crouched then BITFIELD_1_0 += 0x04 end
	buffer.writeu8(SendBuffer, BLOCK_START + 28, BITFIELD_1_0)
end

function SerdesFunctions.WriteEVENT_SPose(Value: CFrame): ()
	-- Allocate BLOCK: 20 bytes
	local BLOCK_START = Allocate(20)
	buffer.writeu8(SendBuffer, BLOCK_START + 0, 4)
	local Position = Value.Position
	local QIndex, QA, QB, QC = PackRotation(Value)
	buffer.writef32(SendBuffer, BLOCK_START + 1, Position.X)
	buffer.writef32(SendBuffer, BLOCK_START + 5, Position.Y)
	buffer.writef32(SendBuffer, BLOCK_START + 9, Position.Z)
	buffer.writeu8(SendBuffer, BLOCK_START + 13, QIndex)
	buffer.writei16(SendBuffer, BLOCK_START + 14, QA)
	buffer.writei16(SendBuffer, BLOCK_START + 16, QB)
	buffer.writei16(SendBuffer, BLOCK_START + 18, QC)
end

function SerdesFunctions.ReadEVENT_CBool(): (boolean)
	-- Read BLOCK: 1 bytes
	local BLOCK_START = Read(1)
	local BITFIELD_1_0
	local RecieveBuffer = RecieveBuffer
	BITFIELD_1_0 = buffer.readu8(RecieveBuffer, BLOCK_START + 0)
	local Value = bit32.btest(BITFIELD_1_0, 0x01)
	return Value
end

function SerdesFunctions.ReadEVENT_CBoolArray(): ({ boolean })
	local RecieveBuffer = RecieveBuffer
	-- START ARRAY
	local Length = ReadVarLength()
	if not (Length <= 1000) then error(`Expected "Length" to be smaller than or equal to 1000, got {Length} instead.`) end
	if (Length + 7) // 8 > buffer.len(RecieveBuffer) - RecieveCursor then error(`Expected "Value" to fit in the {buffer.len(RecieveBuffer) - RecieveCursor} bytes left in the packet, got a length of {Length} instead.`) end
	local Value = table.create(Length)
	do
		local PACKED_OFFSET = Read((Length + 7) // 8)
		local PACKED_WHOLE = Length // 8
		for PACKED_BYTE = 0, PACKED_WHOLE - 1 do
			local PACKED_BITS = buffer.readu8(RecieveBuffer, PACKED_OFFSET + PACKED_BYTE)
			local PACKED_BASE = PACKED_BYTE * 8
			Value[PACKED_BASE + 1] = bit32.btest(PACKED_BITS, 1)
			Value[PACKED_BASE + 2] = bit32.btest(PACKED_BITS, 2)
			Value[PACKED_BASE + 3] = bit32.btest(PACKED_BITS, 4)
			Value[PACKED_BASE + 4] = bit32.btest(PACKED_BITS, 8)
			Value[PACKED_BASE + 5] = bit32.btest(PACKED_BITS, 16)
			Value[PACKED_BASE + 6] = bit32.btest(PACKED_BITS, 32)
			Value[PACKED_BASE + 7] = bit32.btest(PACKED_BITS, 64)
			Value[PACKED_BASE + 8] = bit32.btest(PACKED_BITS, 128)
		end
		if Length % 8 ~= 0 then
			local PACKED_BITS = buffer.readu8(RecieveBuffer, PACKED_OFFSET + PACKED_WHOLE)
			local PACKED_BASE = PACKED_WHOLE * 8
			for PACKED_BIT = 0, Length % 8 - 1 do
				Value[PACKED_BASE + PACKED_BIT + 1] = bit32.btest(PACKED_BITS, bit32.lshift(1, PACKED_BIT))
			end
		end
	end
	-- END ARRAY
	return Value
end

function SerdesFunctions.ReadEVENT_CEntity(): ({ id: number, position: Vector3, orientation: Vector3, health: number, alive: boolean, moving: boolean, crouched: boolean })
	-- Read BLOCK: 28 bytes
	local BLOCK_START = Read(28)
	local BITFIELD_1_0
	local RecieveBuffer = RecieveBuffer
	local Value = {id = false, position = false, orientation = false, health = false, alive = false, moving = false, crouched = false} :: any
	Value.id = buffer.readu16(RecieveBuffer, BLOCK_START + 0)
	do
		local X = buffer.readf32(RecieveBuffer, BLOCK_START + 2)
		local Y = buffer.readf32(RecieveBuffer, BLOCK_START + 6)
		local Z = buffer.readf32(RecieveBuffer, BLOCK_START + 10)
		Value.position = Vector3.new(X, Y, Z)
	end
	do
		local X = buffer.readf32(RecieveBuffer, BLOCK_START + 14)
		local Y = buffer.readf32(RecieveBuffer, BLOCK_START + 18)
		local Z = buffer.readf32(RecieveBuffer, BLOCK_START + 22)
		Value.orientation = Vector3.new(X, Y, Z)
	end
	Value.health = buffer.readu8(RecieveBuffer, BLOCK_START + 26)
	BITFIELD_1_0 = buffer.readu8(RecieveBuffer, BLOCK_START + 27)
	Value.alive = bit32.btest(BITFIELD_1_0, 0x01)
	Value.moving = bit32.btest(BITFIELD_1_0, 0x02)
	Value.crouched = bit32.btest(BITFIELD_1_0, 0x04)
	return Value
end

function SerdesFunctions.ReadEVENT_CInput(): ({ seq: number, moveX: number, moveZ: number, yaw: number, jump: boolean, sprint: boolean })
	-- Read BLOCK: 9 bytes
	local BLOCK_START = Read(9)
