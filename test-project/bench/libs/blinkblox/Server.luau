if not RunService:IsServer() then
    error("Server network module can only be required from the server.")
end

local Reliable: RemoteEvent = ReplicatedStorage:FindFirstChild(BASE_EVENT_NAME .. "_RELIABLE_REMOTE") :: RemoteEvent
if not Reliable then
    local RemoteEvent = Instance.new("RemoteEvent")
    RemoteEvent.Name = BASE_EVENT_NAME .. "_RELIABLE_REMOTE"
    --> Set BEFORE parenting, and that ordering is the whole trick. An attribute written on an
    --> unparented instance replicates atomically with the instance itself; one written afterwards is
    --> a separate replication event with no ordering guarantee against the client's WaitForChild
    --> returning. Doing it here removes the race rather than papering over it with a wait.
    RemoteEvent:SetAttribute("SchemaSignature", SCHEMA_SIGNATURE)
    RemoteEvent.Parent = ReplicatedStorage
    Reliable = RemoteEvent
else
    --> The remote already existed -- planted by Rojo, or left by an earlier build. Here the attribute
    --> IS a separate replication event, so the client tolerates arriving before it.
    Reliable:SetAttribute("SchemaSignature", SCHEMA_SIGNATURE)
end

local Unreliable: UnreliableRemoteEvent = ReplicatedStorage:FindFirstChild(BASE_EVENT_NAME .. "_UNRELIABLE_REMOTE") :: UnreliableRemoteEvent
if not Unreliable then
    local UnreliableRemoteEvent = Instance.new("UnreliableRemoteEvent")
    UnreliableRemoteEvent.Name = BASE_EVENT_NAME .. "_UNRELIABLE_REMOTE"
    UnreliableRemoteEvent.Parent = ReplicatedStorage
    Unreliable = UnreliableRemoteEvent
end

--> The server creates these when they are missing, but FindFirstChild above may have matched an
--> instance of a different class that a plugin or an earlier build left behind. Failing loudly at
--> require time beats failing per packet, forever, at runtime.
assert(Reliable:IsA("RemoteEvent"), "[BlinkBlox]: The reliable remote is not a RemoteEvent.")
assert(Unreliable:IsA("UnreliableRemoteEvent"), "[BlinkBlox]: The unreliable remote is not an UnreliableRemoteEvent.")

local PlayersMap: {[Player]: BLINK_BUFFER_SAVE} = {}

--> THE BROADCAST BATCH. A reliable FireAll is written once, here, and sent at the flush in one
--> FireAllClients, where it used to be copied into every player's batch: fifty players made a FireAll
--> fifty copies and the flush fifty remote calls.
-->
--> A player's own writes still go to their own batch, and the order they and the broadcasts were
--> made in has to survive. A player's first write of their own since a broadcast DIVERGES them: their
--> batch takes a copy of the broadcast batch so far, then their write, and every later broadcast is
--> appended to it as well. At the flush a diverged player is sent their batch alone; everyone else is
--> sent the broadcast batch, after anything of their own that came before the first broadcast. With
--> nobody diverged, that is one FireAllClients.
local SharedSize = 64
local SharedCursor = 0
local SharedBuffer = buffer.create(64)
local SharedInstances: {Instance} = {}
local SharedUnderused = 0
local Diverged: {[Player]: true} = {}

--> How many rows a polled event's queue holds on the server before it stops taking more. Clients fill
--> it, and a game that polls an event rarely, or has not got round to polling it at all, would let
--> them grow it without end -- each row pinning its Player. A game that drains its queues every
--> frame never comes near this, however full the server is.
local MAX_POLLED = 256 * math.max(Players.MaxPlayers, 1)

--> RATE LIMITING. One table per player, four numbers per limited event: tokens left, the clock
--> reading those tokens were last refilled at, the clock reading the last report was made at, and
--> the refusals made since that report, which the next one carries.
--> A flat array rather than a table per event because a player who fires nothing still pays for the
--> allocation, and this is on the path of every inbound packet.
local RateBuckets: {[Player]: {number}} = {}
local RateHandler: ((Player: Player, Event: string?, Refused: number) -> ())? = nil

--> CALLS IN FLIGHT. For each player, how many calls of each function that declares a `Concurrency`
--> the server has accepted and not yet answered, keyed by the function's event index; and beside it
--> the refusals made since the last report. `Rate` bounds how many calls START a second. It says
--> nothing about how many are still RUNNING, and a listener that waits -- a DataStore request, an
--> invocation back to the same client, which that client can leave unanswered for the whole timeout
--> -- turns a steady stream of calls into a growing pile of suspended threads. A hostile client is
--> not held to the 32 outstanding calls an honest one is: it writes whatever invocation ids it likes.
local InFlight: {[Player]: {[number]: number}} = {}
local InFlightRefused: {[Player]: {[number]: number}} = {}

--> THE INBOUND BUDGET. Bytes a player's packets may cost the server, refilled every second, charged
--> before a packet is decoded: tokens left, refill clock, report clock, refusals since that report.
--> Every other limit is per packet or per event, and a client that sends many packets each frame
--> passed all of them while the server decoded every one.
local InboundBudgets: {[Player]: {number}} = {}

--> WHAT A CLIENT CAN MAKE THE SERVER SAY. A packet refused for its shape, its size or its instance
--> count, a packet cut short by the event cap, and a packet that failed to decode are each reported
--> at most once a second per player -- per channel and event, for a decode failure -- the schedule
--> the rate limit's reports already keep. They used
--> to be reported per packet, so a client could put a line in the output, or a call to the game's
--> handler, for every packet it sent: hundreds a second, and the malformed and oversized ones
--> without even being charged to the inbound budget first.
local Reports: {[Player]: {[string]: number}} = {}

local function ShouldReport(Player: Player, Kind: string): boolean
    local Times = Reports[Player]
    if not Times then
        if Player.Parent == nil then
            return false
        end

        Times = {}
        Reports[Player] = Times
    end

    local Now = os.clock()
    local Last = Times[Kind]
    if Last ~= nil and (Now - Last) < 1 then
        return false
    end

    Times[Kind] = Now
    return true
end

--> PACKET REFUSALS, for the game to act on. A packet refused before it is decoded -- malformed
--> arguments, oversized, over the inbound budget, too many instances -- or cut short by the event cap
--> is something only a modified client sends, and a game may want to strike or ban for it. The
--> warning alone told the output, not the game. `Refused` is how many packets of that kind the call
--> stands for, once a second per player and reason. `Detail` is the packet's byte length for
--> Oversized and Budget, its instance count for Instances, the events decoded for Events, 0 otherwise.
--> With a handler installed the warnings are not printed, and Budget no longer reaches the rate-limit
--> handler: the game has said where it wants to hear about packets.
type BLINK_DROP_REASON = "Malformed" | "Oversized" | "Budget" | "Instances" | "Events"
local DropHandler: ((Player: Player, Reason: BLINK_DROP_REASON, Refused: number, Detail: number) -> ())? = nil
local Drops: {[Player]: {[string]: number}} = {}

local function SetPacketDropHandler(Handler: ((Player: Player, Reason: BLINK_DROP_REASON, Refused: number, Detail: number) -> ())?)
    DropHandler = Handler
end

--> The warnings as they were before the handler existed, word for word. Budget has its own, in
--> InboundAccept, since it names the budget.
local DROP_WARNINGS: {[string]: string} = {
    Malformed = "Dropped a malformed packet from %s.",
    Oversized = "Dropped an oversized packet from %s.",
    Instances = "Dropped a packet with too many instances from %s.",
    Events = "Dropped the rest of a packet from %s, too many events.",
}

local function ReportDrop(Player: Player, Reason: BLINK_DROP_REASON, Detail: number)
    local Counts = Drops[Player]
    if not Counts then
        if Player.Parent == nil then
            return
        end

        Counts = {}
        Drops[Player] = Counts
    end

    local Refused = (Counts[Reason] or 0) + 1
    if not ShouldReport(Player, Reason) then
        Counts[Reason] = Refused
        return
    end

    Counts[Reason] = 0
    local Handler = DropHandler
    if Handler then
        --> Spawned: a handler that throws or yields must not reach back into the connection.
        Spawn(Handler, Player, Reason, Refused, Detail)
    else
        warn(`[BlinkBlox]: {string.format(DROP_WARNINGS[Reason], Player.Name)}`)
    end
end

--> Installs the callback told about refused events: at most once per player per event per second,
--> with `Refused` the number of refusals that report stands for. `Event` is nil when what was refused
--> was whole packets over the inbound budget rather than one event, which is reported here only while
--> no packet-drop handler is installed. Nothing is kicked automatically:
--> a false positive under server lag would eject a legitimate player, and whether that is the right
--> response is a decision only the game can make.
local function SetRateLimitHandler(Handler: ((Player: Player, Event: string?, Refused: number) -> ())?)
    RateHandler = Handler
end

--> DECODE FAILURES (upstream issue #102). A packet that cannot be decoded is abandoned where it
--> failed, since the cursor is left mid-event and nothing after it can be trusted. That stays silent
--> by default -- a client sending garbage every frame must not be able to fill the output -- but the
--> game is entitled to know who sent it and what it claimed to be, to log it, flag the account or
--> kick. `Event` is nil when the index named no event at all.
local DecodeHandler: ((Player: Player, Event: string?, Failure: string) -> ())? = nil

local function SetDecodeErrorHandler(Handler: ((Player: Player, Event: string?, Failure: string) -> ())?)
    DecodeHandler = Handler
end

local function ReportDecodeFailure(Player: Player, Channel: string, Event: string?, Failure: unknown)
    local Handler = DecodeHandler
    --> Once a second per player, per channel and per event it claimed to be.
    if Handler and ShouldReport(Player, `{Channel} {Event or "?"}`) then
        --> Spawned for the same reason RateAccept spawns its handler: one that throws or yields must
        --> not reach back into the receive loop that called it.
        Spawn(Handler, Player, Event, tostring(Failure))
    end
end

--> LISTENER ERRORS. A listener that throws on the server -- an event's, Sync or Async, or a function's
--> -- is the game's bug, but the arguments that set it off are a client's: a modified client can make
--> one throw on every packet it sends. With no handler installed the error surfaces as it always did,
--> in the output with nobody named. With one, the handler owns it and the output stays silent: it is
--> told the player, the event, the error and `Count`, the errors that report stands for, at most once
--> a second per player and event on the schedule every other report keeps. A player who has already
--> left is reported at once with a count of 1, since there is no schedule left to hold it on.
local ListenerHandler: ((Player: Player, Event: string, Failure: string, Count: number) -> ())? = nil
local ListenerErrors: {[Player]: {[string]: number}} = {}

local function SetListenerErrorHandler(Handler: ((Player: Player, Event: string, Failure: string, Count: number) -> ())?)
    ListenerHandler = Handler
end

--> Reports a listener's error, or returns false when no handler is installed and the caller should
--> surface it the way it did before the handler existed. Never throws or yields: it runs inside the
--> decode loop's per-event pcall.
local function ListenerFailed(Player: Player, Event: string, Failure: unknown): boolean
    local Handler = ListenerHandler
    if not Handler then
        return false
    end

    local Counts = ListenerErrors[Player]
    if not Counts then
        if Player.Parent == nil then
            Spawn(Handler, Player, Event, tostring(Failure), 1)
            return true
        end

        Counts = {}
        ListenerErrors[Player] = Counts
    end

    local Count = (Counts[Event] or 0) + 1
    if not ShouldReport(Player, `Listener {Event}`) then
        Counts[Event] = Count
        return true
    end

    Counts[Event] = 0
    --> Spawned for RateAccept's reason: a handler that throws or yields must not reach the decoder.
    Spawn(Handler, Player, Event, tostring(Failure), Count)
    return true
end

--> Runs an Async listener, or replays a queued event to one of either kind. Without a handler the
--> listener is called bare, so its error surfaces on its own thread exactly as before; with one it is
--> protected and reported.
local function RunListener<T...>(Event: string, Listener: (Player, T...) -> (), Player: Player, ...: T...)
    if ListenerHandler == nil then
        Listener(Player, ...)
        return
    end

    local Ran: boolean, Failure: any = pcall(Listener, Player, ...)
    if not Ran then
        ListenerFailed(Player, Event, Failure)
    end
end

--> Charges a packet against its sender's inbound budget, or reports and refuses it.
-->
--> Called from the connection before the packet is decoded, so a refusal costs the server a table
--> lookup rather than a decode. The burst is a whole second of budget because the clock here is the
--> server's: after a hitch Roblox delivers the queued packets together, and a refused reliable packet
--> takes every event in it along. Reported on the same once-a-second schedule as RateAccept.
--> When the packet being decoded arrived. Every event in a packet arrived at the same moment, so the
--> rate buckets refill once a packet, at this, rather than asking the clock once an event.
local PacketClock = 0

local function InboundAccept(Player: Player, Length: number, Floor: number, Rate: number, Burst: number): boolean
    local Cost = math.max(Length, Floor)
    if Player.Parent == nil then
        InboundBudgets[Player] = nil
        return false
    end

    local Now = os.clock()
    PacketClock = Now
    local Budget = InboundBudgets[Player]
    if not Budget then
        --> The report clock starts at minus infinity so the first refusal is always reported.
        Budget = {Burst, Now, -math.huge, 0}
        InboundBudgets[Player] = Budget
    end

    local Tokens = math.min(Burst, Budget[1] + ((Now - Budget[2]) * Rate))
    Budget[2] = Now

    if Tokens >= Cost then
        Budget[1] = Tokens - Cost
        return true
    end

    Budget[1] = Tokens
    local Refused = Budget[4] + 1
    if (Now - Budget[3]) < 1 then
        Budget[4] = Refused
        return false
    end

    Budget[3] = Now
    Budget[4] = 0

    --> Spawned, either handler: this runs in the remote's connection, outside any pcall, and a
    --> throwing handler would take the connection's thread with it.
    local Dropped = DropHandler
    if Dropped then
        Spawn(Dropped, Player, "Budget" :: BLINK_DROP_REASON, Refused, Length)
        return false
    end

    --> Without a packet-drop handler, as before it existed: a warning, and the rate-limit handler
    --> with `Event` nil. Kept so a game written against 0.27 to 0.36 hears what it always heard.
    warn(`[BlinkBlox]: Dropped packets from {Player.Name} over the inbound budget of {Rate} bytes a second, {Refused} refused.`)
    local Handler = RateHandler
    if Handler then
        Spawn(Handler, Player, nil, Refused)
    end

    return false
end

--> Refills lazily and spends one token, or reports and refuses.
--> 
--> Called after an event has been DESERIALIZED, never before: payloads are variable length, so an
--> event cannot be skipped without decoding it -- the cursor would be left mid-event and the rest of
--> the packet would decode as garbage. So this bounds listener dispatch and the game logic behind
--> it, while MaxEventsPerPacket bounds the decoding of one packet and InboundAccept how many packets
--> a second get decoded at all. The three limits are different axes.
--> Called only from the decode loop, which stops before any event once the player has left, and
--> no game code runs between that check and this call: a player still here when the loop checked
--> is still here now, so a bucket made below is one PlayerRemoving will clear.
local function RateAccept(Player: Player, Slot: number, Rate: number, Burst: number, Name: string): boolean
    local Bucket = RateBuckets[Player]
    if not Bucket then
        Bucket = table.clone(RATE_TEMPLATE)
        RateBuckets[Player] = Bucket
    end

    local Now = PacketClock
    local Tokens = math.min(Burst, Bucket[Slot] + ((Now - Bucket[Slot + 1]) * Rate))
    Bucket[Slot + 1] = Now

    if Tokens < 1 then
        Bucket[Slot] = Tokens

        --> One report per player per event per second, the warning and the handler alike. An exploit
        --> client sends hundreds a frame; a report per drop would bury the console it is trying to
        --> inform, and spawn the game's handler as often. Refusals in between are counted instead.
        local Refused = Bucket[Slot + 3] + 1
        if (Now - Bucket[Slot + 2]) < 1 then
            Bucket[Slot + 3] = Refused
            return false
        end

        Bucket[Slot + 2] = Now
        Bucket[Slot + 3] = 0
        warn(`[BlinkBlox]: Rate limited event "{Name}" from {Player.Name}, {Refused} refused.`)

        local Handler = RateHandler
        if Handler then
            --> Spawned, not called. This runs inside the per-event pcall that contains a truncated
            --> packet, so a throwing handler would abort the rest of the packet; and a handler that
            --> yields -- an analytics write, a datastore call -- would stall decoding.
            Spawn(Handler, Player, Name, Refused)
        end

        return false
    end

    Bucket[Slot] = Tokens - 1
    return true
end

--> Claims one of a player's `Limit` running calls of function `Index`, or reports and refuses.
-->
--> Called once a call has been decoded and passed its rate limit, before it is dispatched or queued,
--> so a call waiting in the queue for its listener counts as running: it holds the same thread and
--> the same promise of a reply. Refusals are reported on RateAccept's schedule and through its
--> handler, once a second per player per function, carrying the refusals since the last report.
local function ConcurrencyAccept(Player: Player, Index: number, Limit: number, Name: string): boolean
    if Player.Parent == nil then
        InFlight[Player] = nil
        InFlightRefused[Player] = nil
        return false
    end

    local Counts = InFlight[Player]
    if not Counts then
        Counts = {}
        InFlight[Player] = Counts
    end

    local Running = Counts[Index] or 0
    if Running < Limit then
        Counts[Index] = Running + 1
        return true
    end

    local Pending = InFlightRefused[Player]
    if not Pending then
        Pending = {}
        InFlightRefused[Player] = Pending
    end

    local Refused = (Pending[Index] or 0) + 1
    if not ShouldReport(Player, `Concurrency {Index}`) then
        Pending[Index] = Refused
        return false
    end

    Pending[Index] = 0
    warn(`[BlinkBlox]: "{Name}" from {Player.Name} already has {Limit} calls running, {Refused} refused.`)

    local Handler = RateHandler
    if Handler then
        --> Spawned for RateAccept's reason: this runs inside the per-event pcall of the decode loop.
        Spawn(Handler, Player, Name, Refused)
    end

    return false
end

--> Gives back the running call ConcurrencyAccept claimed, once its reply has been written. Every
--> accepted call is answered exactly once -- the listener's reply, its failure reply, or the failure
--> written when the queue is full -- and each of those paths releases, so the count cannot leak. A
--> player who left has no counts to give back to: PlayerRemoving dropped them.
local function ConcurrencyRelease(Player: Player, Index: number)
    local Counts = InFlight[Player]
    if Counts and (Counts[Index] or 0) > 0 then
        Counts[Index] -= 1
    end
end


--> INVOCATION STATE FOR FUNCTIONS THE SERVER CALLS, one set per player rather than the single set
--> Base.luau gives a client. Three separate reasons, and the second is the one that matters.
-->
--> Capacity: that set holds thirty-two outstanding calls in total. A server asking every client a
--> question would exhaust it on the thirty-third player and stay exhausted.
-->
--> Identity: the invocation id is a u8, and the reply carries it back. With one id space shared
--> across players, a reply from player A tagged with an id belonging to a call made to player B would
--> resume B's caller with A's data -- a client choosing which of the server's suspended threads to
--> answer, and what to tell it. Keying by player makes that impossible rather than merely checked:
--> an id from A can only ever be looked up in A's own set.
-->
--> Lifetime: a player who leaves owes an answer to every call outstanding to them, and those callers
--> have to be failed rather than left to sit out the timeout.
local PlayerInvocations: {[Player]: BLINK_INVOCATIONS} = {}

local function InvokePlayer(Player: Player, Index: number): number
    --> Checked before an id is claimed. A player who already left gets no answer from anyone, and
    --> PlayerRemoving has cleared their set, so claiming here would put back a set nothing removes
    --> again and park the caller for the whole timeout to learn what is already known.
    if not Player:IsDescendantOf(Players) then
        error(`[BlinkBlox]: Cannot invoke {Player.Name}, they are no longer in the game.`)
    end

    local State = PlayerInvocations[Player]
    if not State then
        State = CreateInvocations()
        PlayerInvocations[Player] = State
    end

    return ClaimInvocation(State, Index)
end

--> The per-player TimeoutInvocation. A call made while the player was on their way out -- from a
--> PlayerRemoving handler, or a caller retrying the failure it was just handed -- recreates a set
--> PlayerRemoving has already cleared, and nothing else would ever remove it. The timer is the one
--> thing certain to run afterwards, so it is what lets go.
local function TimeoutPlayerInvocation(Player: Player, Identifier: number, Seconds: number, Name: string)
    local State = PlayerInvocations[Player]
    if not State then
        return
    end

    TimeoutInvocation(State, Identifier, Seconds, `"{Name}" was never answered by {Player.Name}`, function()
        if not Player:IsDescendantOf(Players) and PlayerInvocations[Player] == State then
            PlayerInvocations[Player] = nil
        end
    end)
end

Players.PlayerRemoving:Connect(function(Player)
    PlayersMap[Player] = nil
    Diverged[Player] = nil
    RateBuckets[Player] = nil
    InboundBudgets[Player] = nil
    Reports[Player] = nil
    Drops[Player] = nil
    ListenerErrors[Player] = nil
    InFlight[Player] = nil
    InFlightRefused[Player] = nil

    --> Every call outstanding to this player is now unanswerable. Failing them here rather than
    --> leaving them to time out matters because the thread on the other end is game code holding a
    --> lock, a queue slot or a yielded request handler. Their timers go with them.
    local State = PlayerInvocations[Player]
    PlayerInvocations[Player] = nil

    if State then
        local Threads = table.clone(State.Threads)
        for Identifier in table.clone(State.Claimed) do
            ReleaseInvocation(State, Identifier)
        end

        for _, Thread in Threads do
            if coroutine.status(Thread) == "suspended" then
                task.spawn(Thread, false)
            end
        end
    end
end)

--> Writing a player's buffer back is only safe while that player is still in the game.
--> A listener can yield between Load and Save -- a datastore call, a task.wait, any async work --
--> and the player may leave inside that window. PlayerRemoving has already cleared their entry by
--> then, so a plain `PlayersMap[Player] = Save()` puts back an entry that nothing will ever remove
--> again: StepReplication would allocate a buffer and fire a remote at a player who is gone, on
--> every Heartbeat, for the lifetime of the server.
-->
--> Only a new entry needs the check. An entry that exists has not been through PlayerRemoving yet,
--> and one written in its narrow window is dropped by StepReplication; asking the DataModel on every
--> send cost a reflected call per player per event, which is most of what a FireAll cost.
local function SavePlayerBuffer(Player: Player)
    --> Written into the entry the player already has, rather than a new one each time: this runs on
    --> every reliable send to a player, and the entry also carries its shrink count.
    local Entry = PlayersMap[Player]
    if Entry == nil then
        if Player:IsDescendantOf(Players) then
            PlayersMap[Player] = Save()
            if SharedCursor > 0 then
                Diverged[Player] = true
            end
        end
        return
    end

    if SharedCursor > 0 then
        Diverged[Player] = true
    end

    Entry.Size = SendSize
    Entry.Cursor = SendCursor
    Entry.Buffer = SendBuffer
    Entry.Instances = SendInstances
end

--> Loads `Player`'s batch for a write of their own, diverging them first when a broadcast is pending;
--> see the broadcast batch above. The SavePlayerBuffer that follows marks them diverged.
local function LoadPlayer(Player: Player)
    Load(PlayersMap[Player])
    if SharedCursor > 0 and not Diverged[Player] then
        local Position = Allocate(SharedCursor)
        buffer.copy(SendBuffer, Position, SharedBuffer, 0, SharedCursor)
        table.move(SharedInstances, 1, #SharedInstances, #SendInstances + 1, SendInstances)
    end
end

--> Appends an event written elsewhere to one player's batch: a FireList or FireExcept, and a
--> broadcast to a player who has diverged. A player with a batch of their own and nothing to catch up
--> on gets it straight into it; any other goes the long way, through LoadPlayer and SavePlayerBuffer.
local function AppendPlayer(Player: Player, Buffer: buffer, Size: number, Instances: {Instance})
    local Entry = PlayersMap[Player]
    if Entry == nil or (SharedCursor > 0 and not Diverged[Player]) then
        LoadPlayer(Player)
        local Position = Allocate(Size)
        buffer.copy(SendBuffer, Position, Buffer, 0, Size)
        table.move(Instances, 1, #Instances, #SendInstances + 1, SendInstances)
        SavePlayerBuffer(Player)
        return
    end

    local Cursor = Entry.Cursor
    local InUse = Cursor + Size
    local Target = Entry.Buffer
    if InUse > Entry.Size then
        local Grown = Entry.Size
        while InUse > Grown do
            Grown *= 1.5
        end

        local Resized = buffer.create(Grown)
        buffer.copy(Resized, 0, Target, 0, Cursor)
        Target = Resized
        Entry.Buffer = Resized
        Entry.Size = Grown
    end

    buffer.copy(Target, Cursor, Buffer, 0, Size)
    Entry.Cursor = InUse

    local Count = #Instances
    if Count > 0 then
        local List = Entry.Instances
        table.move(Instances, 1, Count, #List + 1, List)
    end
end

--> Appends a broadcast to the broadcast batch, and to the batch of every player who has diverged.
local function AppendShared(Buffer: buffer, Size: number, Instances: {Instance})
    local InUse = SharedCursor + Size
    if InUse > SharedSize then
        while InUse > SharedSize do
            SharedSize *= 1.5
        end

        local Resized = buffer.create(SharedSize)
        buffer.copy(Resized, 0, SharedBuffer, 0, SharedCursor)
        SharedBuffer = Resized
    end

    buffer.copy(SharedBuffer, SharedCursor, Buffer, 0, Size)
    SharedCursor = InUse
    if #Instances > 0 then
        table.move(Instances, 1, #Instances, #SharedInstances + 1, SharedInstances)
    end

    for Player in Diverged do
        AppendPlayer(Player, Buffer, Size, Instances)
    end
end

local function StepReplication()
    local Shared = SharedCursor
    for Player, Send in PlayersMap do
        --> Second line of defence. An entry can still be stale if it was written inside the narrow
        --> window of PlayerRemoving itself, before the player was detached; dropping it here makes
        --> the leak self-healing instead of permanent.
        if not Player:IsDescendantOf(Players) then
            PlayersMap[Player] = nil
            continue
        end

        --> Everything of this player's own came before the first broadcast, so the broadcast batch
        --> follows it in their packet rather than going in one of its own.
        if Shared > 0 and Send.Cursor > 0 and not Diverged[Player] then
            Load(Send)
            local Position = Allocate(Shared)
            buffer.copy(SendBuffer, Position, SharedBuffer, 0, Shared)
            table.move(SharedInstances, 1, #SharedInstances, #SendInstances + 1, SendInstances)
            Send.Size = SendSize
            Send.Cursor = SendCursor
            Send.Buffer = SendBuffer
            Diverged[Player] = true
        end

        local Used = Send.Cursor
        if Used > 0 then
            local Buffer = buffer.create(Used)
            buffer.copy(Buffer, 0, Send.Buffer, 0, Used)
            Reliable:FireClient(Player, Buffer, Send.Instances)

            Send.Cursor = 0
            table.clear(Send.Instances)
        end

        --> The buffer this player's writes grew is kept for the next frame rather than regrown from
        --> 64 bytes every Heartbeat: only the exact-size copy above goes on the wire, and every writer
        --> writes whole bytes, so what is left past the cursor is never read. One that has sat mostly
        --> empty for a second is let go, so a burst is not held for the rest of the session; see
        --> ShouldShrink.
        local Shrink, Underused = ShouldShrink(Send.Size, Used, Send.Underused or 0)
        Send.Underused = Underused
        if Shrink then
            Send.Size = 64
            Send.Buffer = buffer.create(64)
        end
    end

    if Shared > 0 then
        local Buffer = buffer.create(Shared)
        buffer.copy(Buffer, 0, SharedBuffer, 0, Shared)
        if next(Diverged) == nil then
            Reliable:FireAllClients(Buffer, SharedInstances)
        else
            for _, Player in Players:GetPlayers() do
                if not Diverged[Player] then
                    Reliable:FireClient(Player, Buffer, SharedInstances)
                end
            end
        end

        SharedCursor = 0
        table.clear(SharedInstances)
        table.clear(Diverged)
    end

    local Shrink
    Shrink, SharedUnderused = ShouldShrink(SharedSize, Shared, SharedUnderused)
    if Shrink then
        SharedSize = 64
        SharedBuffer = buffer.create(64)
    end
end

--> UNRELIABLE BATCHES; see Generator/Batches.luau.
--> `Committed` counts the Instances of the events kept. `Pending` is set while an event is written
--> straight into the batch: one that then threw has left its own Instances behind, and they are
--> dropped before the batch is used again. Checking the flag spares every other use a count.
type BLINK_UNRELIABLE = { Buffer: buffer, Size: number, Cursor: number, Instances: {Instance}, Committed: number, Events: number, Pending: boolean }

local function NewUnreliable(): BLINK_UNRELIABLE
    return { Buffer = buffer.create(64), Size = 64, Cursor = 0, Instances = {}, Committed = 0, Events = 0, Pending = false }
end

local function Clean(Batch: BLINK_UNRELIABLE)
    if not Batch.Pending then
        return
    end

    local Instances = Batch.Instances
    for Index = #Instances, Batch.Committed + 1, -1 do
        Instances[Index] = nil
    end
    Batch.Pending = false
end

--> Appends what the scratch buffer holds -- one event, written there by the send -- to `Batch`.
local function CopyUnreliable(Batch: BLINK_UNRELIABLE): number
    local Size = SendCursor
    local Cursor = Batch.Cursor
    local InUse = Cursor + Size
    if InUse > Batch.Size then
        local Grown = Batch.Size
        while InUse > Grown do
            Grown *= 1.5
        end

        local Resized = buffer.create(Grown)
        buffer.copy(Resized, 0, Batch.Buffer, 0, Cursor)
        Batch.Buffer = Resized
        Batch.Size = Grown
    end

    buffer.copy(Batch.Buffer, Cursor, SendBuffer, 0, Size)
    Batch.Cursor = InUse
    Batch.Events += 1

    local Count = #SendInstances
    if Count > 0 then
        table.move(SendInstances, 1, Count, Batch.Committed + 1, Batch.Instances)
        Batch.Committed += Count
    end

    return Cursor
end

--> Whether the event in the scratch buffer would take `Batch` past the unreliable limit.
local function Overflows(Batch: BLINK_UNRELIABLE): boolean
    return Batch.Cursor + SendCursor + (Batch.Committed + #SendInstances) * UNRELIABLE_INSTANCE_BYTES > MAX_UNRELIABLE_SIZE
end

local SharedUnreliable = NewUnreliable()
local PlayerUnreliable: {[Player]: BLINK_UNRELIABLE} = {}

Players.PlayerRemoving:Connect(function(Player)
    PlayerUnreliable[Player] = nil
end)

local function SendUnreliable(Batch: BLINK_UNRELIABLE, Player: Player?)
    local Used = Batch.Cursor
    if Used == 0 then
        return
    end

    Clean(Batch)
    local Packet = buffer.create(Used)
    buffer.copy(Packet, 0, Batch.Buffer, 0, Used)
    if Player then
        Unreliable:FireClient(Player, Packet, Batch.Instances)
    else
        Unreliable:FireAllClients(Packet, Batch.Instances)
    end

    Batch.Cursor = 0
    Batch.Events = 0
    if Batch.Committed > 0 then
        Batch.Committed = 0
        table.clear(Batch.Instances)
    end
end

--> A player's batch, made on their first unreliable event of the session. None for a player who has
--> already left: PlayerRemoving has run, and nothing would clear a batch made now.
local function PlayerBatch(Player: Player): BLINK_UNRELIABLE?
    local Batch = PlayerUnreliable[Player]
    if Batch == nil then
        if Player.Parent == nil then
            return nil
        end

        Batch = NewUnreliable()
        PlayerUnreliable[Player] = Batch
    end

    return Batch
end

--> Appends the event in the scratch buffer to everyone's batch, or to `Player`'s.
local function AppendUnreliable(Player: Player?)
    local Batch = if Player then PlayerBatch(Player) else SharedUnreliable
    if Batch == nil then
        return
    end

    Clean(Batch)
    if Overflows(Batch) then
        SendUnreliable(Batch, Player)
    end
    CopyUnreliable(Batch)
end

--> Where the event being written straight into a batch began: its first byte, and the Instances ahead
--> of it.
local BatchStart = 0
local BatchInstances = 0

--> Installs everyone's batch, or `Player`'s, as the send buffer, so a send to one batch writes its event
--> there and copies nothing. None for a player who has left, who is written into the scratch buffer
--> and sent nothing.
local function LoadBatch(Player: Player?): BLINK_UNRELIABLE?
    local Batch = if Player then PlayerBatch(Player) else SharedUnreliable
    if Batch == nil then
        LoadScratch()
        BatchStart = 0
        BatchInstances = 0
        return nil
    end

    Clean(Batch)
    Batch.Pending = true
    SendSize = Batch.Size
    SendCursor = Batch.Cursor
    SendBuffer = Batch.Buffer
    SendInstances = Batch.Instances
    BatchStart = Batch.Cursor
    BatchInstances = Batch.Committed
    return Batch
end

--> Keeps the event just written into `Batch`, stamping an ordered one's sequence at `Slot`. When the
--> event does not fit one packet beside what the batch already held, that goes first, on its own, and
--> the event moves to the front.
local function CommitBatch(Batch: BLINK_UNRELIABLE?, Player: Player?, Slot: number?, Instances: boolean)
    if Batch == nil then
        return
    end

    local Buffer = SendBuffer
    local Start = BatchStart
    local Count = if Instances then #SendInstances else BatchInstances
    if Start > 0 and SendCursor + Count * UNRELIABLE_INSTANCE_BYTES > MAX_UNRELIABLE_SIZE then
        local Packet = buffer.create(Start)
        buffer.copy(Packet, 0, Buffer, 0, Start)
        local Before = table.move(SendInstances, 1, BatchInstances, 1, {})
        if Player then
            Unreliable:FireClient(Player, Packet, Before)
        else
            Unreliable:FireAllClients(Packet, Before)
        end

        local Size = SendCursor - Start
        buffer.copy(Buffer, 0, Buffer, Start, Size)
        table.move(SendInstances, BatchInstances + 1, Count, 1, SendInstances)
        for Index = Count, Count - BatchInstances + 1, -1 do
            SendInstances[Index] = nil
        end

        SendCursor = Size
        Count -= BatchInstances
        Start = 0
        Batch.Events = 0
    end

    Batch.Buffer = Buffer
    Batch.Size = SendSize
    Batch.Cursor = SendCursor
    Batch.Committed = Count
    Batch.Pending = false
end

local StepBeforeUnreliable = StepReplication
--> A batch is made only for a player still in the game, and PlayerRemoving drops it, so the flush asks
--> nobody whether they are still here: that was a property read per player per frame.
StepReplication = function()
    StepBeforeUnreliable()
    SendUnreliable(SharedUnreliable, nil)
    for Player, Batch in PlayerUnreliable do
        if Batch.Cursor > 0 then
            SendUnreliable(Batch, Player)
        end
    end
end
local function DecodeLoop(DecodeEvent: () -> (), Player: Player, Size: number)
	local DecodedEvents = 0
	while RecieveCursor < Size and Player.Parent ~= nil do
		DecodedEvents += 1
		if DecodedEvents > 4096 then
			ReportDrop(Player, "Events", 4096)
			break
		end
		DecodeEvent()
	end
end
RunService.Heartbeat:Connect(StepReplication)
Reliable.OnServerEvent:Connect(function(Player: Player, Buffer: buffer, Instances: {Instance})
	if typeof(Buffer) ~= "buffer" or type(Instances) ~= "table" then
