					"Scenario": "check",
					"Duration": 20,
					"Rate": 30,
					"PayloadSize": 64,
					"Clients": 0
				}
			},
			"LorenTest": {
				"$className": "Folder",
				"LorenTest": {
					"$path": "runner/LorenTest.luau"
				},
				"Harness": {
					"$path": "studio/Harness"
				},
				"Bots": {
					"$path": "bots"
				},
				"RawClient": {
					"$path": "raw/RawClient.luau"
				},
				"Specs": {
					"$className": "Folder",
					"StudioClient": {
						"$path": "specs/studio/client"
