						"$path": "specs/runner"
					},
					"StudioServer": {
						"$path": "specs/studio/server"
					}
				}
			}
		},
		"StarterPlayer": {
			"StarterPlayerScripts": {
				"LorenTestClient": {
					"$path": "studio/Client.client.luau"
				}
			}
		},
		"Players": {
			"$properties": {
				"CharacterAutoLoads": false
			}
		}
	}
