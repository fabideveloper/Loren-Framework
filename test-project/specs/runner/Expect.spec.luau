--!strict
-- Self-tests for LorenTest's expect() matchers and spy().
return function(t: any)
	local describe, it, expect = t.describe, t.it, t.expect

	-- Runs fn and returns its error message ("" if it did not throw).
	local function failureOf(fn: () -> ()): string
		local ok, err = pcall(fn :: any)
		return if ok then "" else tostring(err)
	end

	describe("toBe", function()
		it("passes for equal primitives, the same table and NaN", function()
			local tbl = {}
			expect(1).toBe(1)
			expect("a").toBe("a")
			expect(tbl).toBe(tbl)
			expect(0 / 0).toBe(0 / 0)
			expect(Vector3.new(1, 2, 3)).toBe(Vector3.new(1, 2, 3))
		end)

		it("fails for different tables with a readable message", function()
			local message = failureOf(function()
				expect(1).toBe(2)
			end)
			expect(message).toContain("expected 1 to be 2")
			expect(failureOf(function()
				expect({}).toBe({})
			end)).never.toBe("")
		end)

		it("points the failure at the spec line", function()
			local message = failureOf(function()
				expect(true).toBe(false)
			end)
			expect(message).toContain("Expect.spec:")
		end)

		it("supports colon calls", function()
			expect(5):toBe(5)
			expect(failureOf(function()
				expect(5):toBe(6)
			end)).toContain("expected 5 to be 6")
		end)
	end)

	describe("toEqual", function()
		it("compares nested tables, NaN and datatypes deeply", function()
			expect({ a = { b = { 1, 2, 3 } }, n = 0 / 0 }).toEqual({ a = { b = { 1, 2, 3 } }, n = 0 / 0 })
			expect({ CFrame.new(1, 2, 3) }).toEqual({ CFrame.new(1, 2, 3) })
		end)

		it("reports the path of the first difference", function()
			expect(failureOf(function()
				expect({ a = { b = 1 } }).toEqual({ a = { b = 2 } })
			end)).toContain("value.a.b")
			expect(failureOf(function()
				expect({ a = 1 }).toEqual({ a = 1, extra = true })
			end)).toContain("missing")
		end)

		it("handles cyclic tables", function()
			local a, b = {}, {}
			a.self, b.self = a, b
			expect(a).toEqual(b)
		end)

		it("compares buffers by content", function()
			local x, y = buffer.fromstring("abc"), buffer.fromstring("abc")
			expect(x).toEqual(y)
			expect(x).never.toEqual(buffer.fromstring("abd"))
		end)
	end)

	describe("truthiness and nil", function()
		it("toBeNil, toBeTruthy, toBeFalsy", function()
			expect(nil).toBeNil()
			expect(false).never.toBeNil()
			expect(0).toBeTruthy()
			expect("").toBeTruthy()
			expect(false).toBeFalsy()
			expect(nil).toBeFalsy()
			expect(failureOf(function()
				expect(1).toBeNil()
			end)).toContain("to be nil")
		end)
	end)

	describe("toThrow", function()
		it("passes when the function throws, optionally matching a plain or Lua pattern", function()
			expect(function()
				error("boom 42")
			end).toThrow()
			expect(function()
				error("boom 42")
			end).toThrow("boom")
			expect(function()
				error("boom 42")
			end).toThrow("%d+")
			expect(function()
				error("a.b(c)")
			end).toThrow("a.b(c)") -- plain match first, so special characters work
		end)

		it("fails when nothing is thrown or the message does not match", function()
			expect(failureOf(function()
				expect(function() end).toThrow()
			end)).toContain("expected the function to throw")
			expect(failureOf(function()
				expect(function()
					error("other")
				end).toThrow("boom")
			end)).toContain("matching")
		end)

		it("never.toThrow passes for a function that returns", function()
			expect(function() end).never.toThrow()
		end)

		it("is a usage error on a non-function, even with never", function()
			expect(failureOf(function()
				expect(1).never.toThrow()
			end)).toContain("not a function")
		end)
	end)

	describe("numbers", function()
		it("toBeCloseTo uses decimal digits (default 2)", function()
			expect(0.1 + 0.2).toBeCloseTo(0.3)
			expect(1.005).toBeCloseTo(1, 1)
			expect(1.1).never.toBeCloseTo(1)
			expect(math.huge).toBeCloseTo(math.huge)
		end)

		it("comparisons", function()
			expect(2).toBeGreaterThan(1)
			expect(2).toBeGreaterThanOrEqual(2)
			expect(1).toBeLessThan(2)
			expect(2).toBeLessThanOrEqual(2)
			expect(1).never.toBeGreaterThan(1)
			expect(0 / 0).never.toBeGreaterThan(0) -- NaN compares false
		end)

		it("comparisons on non-numbers are usage errors, even with never", function()
			expect(failureOf(function()
				expect("2").never.toBeGreaterThan(1)
			end)).toContain("needs numbers")
		end)
	end)

	describe("collections", function()
		it("toContain on strings (plain) and tables", function()
			expect("hello world").toContain("o w")
			expect("a.b").toContain(".")
			expect({ 1, 2, 3 }).toContain(2)
			expect({ a = "x" }).toContain("x")
			expect({ 1, 2 }).never.toContain(3)
		end)

		it("toHaveLength on strings, arrays and buffers", function()
			expect("abc").toHaveLength(3)
			expect({ 1, 2 }).toHaveLength(2)
			expect(buffer.create(7)).toHaveLength(7)
			expect({}).never.toHaveLength(1)
		end)
	end)

	describe("spy", function()
		it("records calls and forwards to the wrapped function", function()
			local spy = t.spy(function(a: number, b: number)
				return a + b
			end)
			expect(spy(1, 2)).toBe(3)
			expect(spy.fn(3, 4)).toBe(7)
			expect(spy.count).toBe(2)
			expect(spy.calls[1][1]).toBe(1)
			expect(spy.calls[2].n).toBe(2)
		end)

		it("keeps nil arguments in the argument count", function()
			local spy = t.spy()
			spy(nil, 2, nil)
			expect(spy.calls[1].n).toBe(3)
			expect(spy.calls[1][2]).toBe(2)
		end)
	end)
end
